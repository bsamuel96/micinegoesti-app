NODE_ENV=development
PORT=4000
LOG_DIR=logs
LOG_STORAGE=file
CLIENT_URL=http://localhost:5173,http://localhost:5174
# In production, set both values to the public storefront origins, for example:
# CLIENT_URL=https://micinegoesti.ro
# CORS_ORIGINS=https://micinegoesti.ro,https://www.micinegoesti.ro
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
DATABASE_URL=file:./dev.db
JWT_SECRET=replace-with-a-long-random-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_PRODUCT_IMAGES_BUCKET=product-images
STORE_LATITUDE=44.380758
STORE_LONGITUDE=26.167395
MAX_DELIVERY_RADIUS_KM=20
REVERSE_GEOCODING_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=MiciDeNegoesti/1.0 (https://micinegoesti.ro)
GEOCODING_CONTACT_EMAIL=contact@micinegoesti.ro
GEOCODING_CACHE_TTL_MS=86400000
PRODUCT_IMAGES_MAX_COUNT=8
PRODUCT_IMAGES_MAX_FILE_SIZE=10485760
PRODUCT_IMAGES_MAX_DIMENSION=1920
PRODUCT_IMAGES_WEBP_QUALITY=82

# Initial admin created by `npm run db:seed`
ADMIN_PHONE=+40740000000
ADMIN_EMAIL=admin@micinegoesti.ro
ADMIN_NAME=Admin Mici de Negoești
ADMIN_PASSWORD=change-this-admin-password

# Optional dummy customer login (frontend quick-login button)
DUMMY_CUSTOMER_ENABLED=false
DUMMY_CUSTOMER_PHONE=+40700000000
DUMMY_CUSTOMER_NAME=Client Demo

# WhatsApp provider. Use `log` locally; set to `green-api` or `wawp` in production.
WHATSAPP_PROVIDER=log
WHATSAPP_STORE_NUMBER=+40747232306
GREEN_API_API_URL=https://api.greenapi.com
GREEN_API_ID_INSTANCE=
GREEN_API_API_TOKEN_INSTANCE=
WAWP_API_BASE_URL=https://api.wawp.net
WAWP_INSTANCE_ID=
WAWP_ACCESS_TOKEN=

# Verification codes
VERIFY_CODE_TTL_MINUTES=10
OTP_RATE_LIMIT_WINDOW_MINUTES=15
OTP_RATE_LIMIT_MAX=5
DEFAULT_COUNTRY_CODE=RO
